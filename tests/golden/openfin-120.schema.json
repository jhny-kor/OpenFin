{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/tests/golden/openfin-120.schema.json",
  "title": "OpenFin live regression case",
  "type": "object",
  "required": ["case_id", "category", "tool", "arguments", "expected_status", "required_fields", "forbidden_claims", "expected_reason_codes"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "category": { "enum": ["exact_search", "alias_search", "ambiguous_query", "comparison", "eligibility", "freshness", "recommendation_gate", "security", "unknown", "deployment"] },
    "tool": { "enum": ["get_openfin_quality_status", "search", "fetch", "discover", "compare", "recommend", "evaluate_product_fit", "calculate_finance_metrics", "exports"] },
    "arguments": { "type": "object" },
    "expected_status": { "enum": ["ok", "ready", "blocked", "insufficient_information", "error"] },
    "required_fields": { "type": "array", "items": { "type": "string" } },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } },
    "expected_reason_codes": { "type": "array", "items": { "type": "string" } },
    "expect_error": { "type": "boolean" },
    "expected_paths": { "type": "object", "additionalProperties": true },
    "expected_result_ids": { "type": "array", "items": { "type": "string" } },
    "forbidden_result_ids": { "type": "array", "items": { "type": "string" } },
    "expected_candidate_order": { "type": "array", "items": { "type": "string" } },
    "expected_source_ids": { "type": "array", "items": { "type": "string" } },
    "expected_freshness_status": { "type": "string" },
    "freshness_path": { "type": "string" },
    "expected_unknown_conditions": { "type": "array", "items": { "type": "string" } },
    "search_contract": { "$ref": "#/$defs/search_contract" },
    "semantic_search": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["query", "expected_top_id", "expected_title", "expected_top_k_ids", "expected_result_ids", "expected_source_ids", "require_freshness", "fetch_id"],
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "expected_top_id": { "type": "string", "minLength": 1 },
          "expected_title": { "type": "string", "minLength": 1 },
          "expected_top_k_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "expected_result_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "expected_result_ids_any": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "expected_source_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "require_freshness": { "type": "boolean" },
          "expected_freshness_status": { "type": "string", "minLength": 1 },
          "fetch_id": { "type": "string", "minLength": 1 },
          "category_contract": { "$ref": "#/$defs/search_contract" },
          "intent_contract": {
            "type": "object",
            "properties": {
              "expected_result_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            },
            "required": ["expected_result_ids"],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "search_contract": {
      "type": "object",
      "properties": {
        "minimum_result_count": { "type": "integer", "minimum": 1 },
        "allowed_types": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "forbidden_types": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "provider_diversity_count": { "type": "integer", "minimum": 3 },
        "require_source_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "require_freshness": { "type": "boolean" },
        "freshness_status": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
