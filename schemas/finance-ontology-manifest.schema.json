{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["release_status", "core_search_status", "platform_release_status", "comparison_release_status", "recommendation_release_status", "domain_readiness", "generation_id", "decision_offers", "capabilities", "candidate_counts", "artifact_contract"],
  "properties": {
    "release_status": { "enum": ["ready", "degraded"] },
    "core_search_status": { "enum": ["ready", "degraded"] },
    "platform_release_status": { "enum": ["ready", "degraded"] },
    "comparison_release_status": { "enum": ["blocked", "limited"] },
    "recommendation_release_status": { "enum": ["ready", "blocked"] },
    "recommendation_state": { "enum": ["blocked", "shadow", "owner_pilot", "review_ready", "limited_public", "public", "suspended"] },
    "recommendation_state_contract_version": { "type": "string" },
    "recommendation_approval_receipt": { "type": ["object", "null"] },
    "capabilities": { "type": "object", "required": ["discovery", "comparison", "recommendation"], "properties": { "discovery": { "enum": ["ready", "blocked"] }, "comparison": { "enum": ["blocked", "limited_public", "public"] }, "recommendation": { "enum": ["blocked", "shadow", "owner_pilot", "review_ready", "limited_public", "public"] } }, "additionalProperties": false },
    "candidate_counts": { "type": "object", "additionalProperties": { "type": "object", "required": ["strict_offer_count", "comparison_eligible_candidate_count", "public_comparison_candidate_count", "shadow_recommendation_candidate_count", "owner_pilot_candidate_count", "public_recommendation_candidate_count"], "additionalProperties": true } },
    "source_freshness_status": { "enum": ["ready", "degraded"] },
    "decision_offers": {
      "type": "object",
      "required": ["id", "path", "url", "item_count", "export_checksum", "content_checksum"],
      "properties": {
        "id": { "const": "openfin-decision-offers" },
        "path": { "type": "string", "pattern": "^opentax/" },
        "url": { "type": "string", "format": "uri" },
        "item_count": { "type": "integer", "minimum": 0 },
        "export_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "content_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": true
    },
    "domain_readiness": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["structural_candidate_count", "value_complete_candidate_count", "field_verified_candidate_count", "runtime_eligible_candidate_count", "public_candidate_count", "strict_offer_count", "comparison_eligible_candidate_count", "public_comparison_candidate_count", "shadow_recommendation_candidate_count", "owner_pilot_candidate_count", "public_recommendation_candidate_count", "status"],
        "properties": {
          "structural_candidate_count": { "type": "integer", "minimum": 0 },
          "value_complete_candidate_count": { "type": "integer", "minimum": 0 },
          "field_verified_candidate_count": { "type": "integer", "minimum": 0 },
          "runtime_eligible_candidate_count": { "type": "integer", "minimum": 0 },
          "public_candidate_count": { "type": "integer", "minimum": 0 },
          "strict_offer_count": { "type": "integer", "minimum": 0 },
          "comparison_eligible_candidate_count": { "type": "integer", "minimum": 0 },
          "public_comparison_candidate_count": { "type": "integer", "minimum": 0 },
          "shadow_recommendation_candidate_count": { "type": "integer", "minimum": 0 },
          "owner_pilot_candidate_count": { "type": "integer", "minimum": 0 },
          "public_recommendation_candidate_count": { "type": "integer", "minimum": 0 },
          "schema_defined": { "type": "boolean" },
        "required_field_total": { "type": ["integer", "null"], "minimum": 0 },
        "value_complete_field_count": { "type": ["integer", "null"], "minimum": 0 },
        "field_verified_count": { "type": ["integer", "null"], "minimum": 0 },
        "value_field_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "field_verification_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "decision_field_completeness": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "complete_field_count": { "type": ["integer", "null"], "minimum": 0 },
          "status": { "enum": ["blocked", "engine_ready", "structural_only", "pilot_verified", "limited_public_ready", "domain_coverage_incomplete", "schema_not_defined"] }
        }
      }
    },
    "generation_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact_contract": {
      "type": "object",
      "required": ["version", "readiness_schema_version", "generation_id", "deployment_commit", "canonical_content_checksum", "search_index_checksum", "source_status_checksum", "release_policy_checksum", "fixture_checksum", "capability_policy_checksum"],
      "properties": {
        "version": { "const": "openfin-artifact-contract-v1" },
        "readiness_schema_version": { "const": "openfin-readiness-v2" },
        "generation_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "deployment_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$|^unknown$" },
        "canonical_content_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "search_index_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_status_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "release_policy_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fixture_checksum": { "type": ["string", "null"], "pattern": "^(sha256:)?[a-f0-9]{64}$" },
        "capability_policy_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "deployment_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$|^unknown$" },
    "release_status_deprecated": { "const": true },
    "release_status_replacement_path": { "const": "core_search_status" }
  }
}
