{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/manifest.schema.json",
  "title": "OpenFin capability manifest",
  "type": "object",
  "required": ["capabilities", "candidate_counts"],
  "properties": {
    "capabilities": { "type": "object", "required": ["discovery", "comparison", "recommendation"], "properties": { "discovery": { "enum": ["ready", "blocked"] }, "comparison": { "enum": ["blocked", "limited_public", "public"] }, "recommendation": { "enum": ["blocked", "shadow", "owner_pilot", "review_ready", "limited_public", "public"] } }, "additionalProperties": false },
    "candidate_counts": { "type": "object", "additionalProperties": { "type": "object", "required": ["strict_offer_count", "comparison_eligible_candidate_count", "public_comparison_candidate_count", "shadow_recommendation_candidate_count", "owner_pilot_candidate_count", "public_recommendation_candidate_count"], "properties": { "strict_offer_count": { "type": "integer", "minimum": 0 }, "comparison_eligible_candidate_count": { "type": "integer", "minimum": 0 }, "public_comparison_candidate_count": { "type": "integer", "minimum": 0 }, "shadow_recommendation_candidate_count": { "type": "integer", "minimum": 0 }, "owner_pilot_candidate_count": { "type": "integer", "minimum": 0 }, "public_recommendation_candidate_count": { "type": "integer", "minimum": 0 } }, "additionalProperties": true } }
  },
  "additionalProperties": true
}
