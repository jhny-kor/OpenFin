{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/manifest.schema.json",
  "title": "OpenFin capability manifest",
  "type": "object",
  "required": ["capabilities", "candidate_counts"],
  "properties": {
    "capabilities": { "type": "object", "required": ["search", "discovery", "comparison", "shadow", "owner_pilot", "recommendation"], "properties": { "search": { "$ref": "https://jhny-kor.github.io/OpenFin/schemas/capability-status.schema.json#/$defs/capability_status" }, "discovery": { "$ref": "https://jhny-kor.github.io/OpenFin/schemas/capability-status.schema.json#/$defs/capability_status" }, "comparison": { "$ref": "https://jhny-kor.github.io/OpenFin/schemas/capability-status.schema.json#/$defs/capability_status" }, "shadow": { "$ref": "https://jhny-kor.github.io/OpenFin/schemas/capability-status.schema.json#/$defs/capability_status" }, "owner_pilot": { "$ref": "https://jhny-kor.github.io/OpenFin/schemas/capability-status.schema.json#/$defs/capability_status" }, "recommendation": { "$ref": "https://jhny-kor.github.io/OpenFin/schemas/capability-status.schema.json#/$defs/capability_status" } }, "additionalProperties": false },
    "candidate_counts": { "type": "object", "additionalProperties": { "type": "object", "required": ["strict_offer_count", "strict_option_count", "structural_option_count", "comparison_eligible_candidate_count", "public_comparison_candidate_count", "shadow_recommendation_candidate_count", "owner_pilot_candidate_count", "public_recommendation_candidate_count"], "properties": { "strict_offer_count": { "type": "integer", "minimum": 0 }, "strict_option_count": { "type": "integer", "minimum": 0 }, "structural_option_count": { "type": "integer", "minimum": 0 }, "comparison_eligible_candidate_count": { "type": "integer", "minimum": 0 }, "public_comparison_candidate_count": { "type": "integer", "minimum": 0 }, "shadow_recommendation_candidate_count": { "type": "integer", "minimum": 0 }, "owner_pilot_candidate_count": { "type": "integer", "minimum": 0 }, "public_recommendation_candidate_count": { "type": "integer", "minimum": 0 } }, "additionalProperties": true } }
  },
  "additionalProperties": true
}
