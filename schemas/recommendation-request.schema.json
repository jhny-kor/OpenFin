{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/recommendation-request.schema.json",
  "title": "OpenFin recommendation request",
  "type": "object",
  "required": ["domain"],
  "properties": {
    "domain": { "enum": ["deposit", "saving", "card", "loan", "insurance"] },
    "context": { "$ref": "recommendation-context.schema.json" },
    "profile": { "type": "object", "properties": { "provider": { "type": "string" }, "term_months": { "type": "integer", "minimum": 1 }, "risk_capacity": { "type": "string", "enum": ["low", "medium", "high"] }, "liquidity_horizon_months": { "type": "integer", "minimum": 0 }, "tax_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 } }, "additionalProperties": false },
    "constraints": { "$ref": "recommendation-context.schema.json#/definitions/hard_constraints" },
    "preferences": { "$ref": "recommendation-context.schema.json#/definitions/preferences" },
    "decision_context": { "type": "object", "properties": { "as_of": { "type": ["string", "null"], "format": "date" }, "risk_capacity": { "type": "string", "enum": ["low", "medium", "high"] }, "liquidity_requirement": { "type": "object", "properties": { "months": { "type": "number", "minimum": 0 }, "required_amount_krw": { "type": "number", "minimum": 0 } }, "additionalProperties": false } }, "additionalProperties": false },
    "limit": { "type": "integer", "minimum": 1, "maximum": 20 }
  },
  "additionalProperties": false
}
