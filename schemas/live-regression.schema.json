{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "category", "tool", "arguments", "expected_status", "required_fields", "forbidden_claims", "expected_reason_codes"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "tool": { "enum": ["get_openfin_quality_status", "search", "fetch"] },
    "arguments": { "type": "object" },
    "expected_status": { "const": "ok" },
    "required_fields": { "type": "array", "items": { "type": "string" } },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } },
    "expected_reason_codes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
