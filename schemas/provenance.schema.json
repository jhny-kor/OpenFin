{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/provenance.schema.json",
  "title": "OpenFin provenance assertion",
  "type": "object",
  "required": ["source_id", "original_url", "collected_at", "reviewed_at", "supported_fields", "verification_status"],
  "properties": {
    "source_id": { "type": "string", "pattern": "^source\\." },
    "original_url": { "type": "string", "pattern": "^https?://" },
    "source_record_id": { "type": ["string", "number", "null"] },
    "locator": { "type": ["object", "null"] },
    "supported_fields": { "type": "array", "items": { "type": "string" } },
    "source_published_at": { "type": ["string", "null"], "format": "date-time" },
    "source_modified_at": { "type": ["string", "null"], "format": "date-time" },
    "collected_at": { "type": "string", "format": "date-time" },
    "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "valid_from": { "type": ["string", "null"], "format": "date-time" },
    "valid_to": { "type": ["string", "null"], "format": "date-time" },
    "checksum": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "checksum_scope": { "type": ["string", "null"] },
    "verification_status": { "enum": ["verified", "reference_only", "listing_only", "conflict", "unverified"] }
  },
  "additionalProperties": true
}
