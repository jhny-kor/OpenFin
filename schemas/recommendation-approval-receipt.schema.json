{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/recommendation-approval-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_id", "domain", "mode", "generation_id", "candidate_set_checksum", "policy_version", "ranking_version", "calculator_version", "quality_suite_checksum", "approved_at", "expires_at", "reviewer", "reviewer_role", "reviewer_permission", "reviewer_signature", "reviewer_signature_algorithm", "rollback_generation_id"],
  "properties": {
    "approval_id": { "type": "string", "minLength": 1 },
    "domain": { "enum": ["deposit", "saving", "card", "loan", "insurance", "pension"] },
    "mode": { "enum": ["owner_pilot", "review_ready", "limited_public", "public"] },
    "generation_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_set_checksum": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
    "policy_version": { "type": "string", "minLength": 1 },
    "ranking_version": { "type": "string", "minLength": 1 },
    "calculator_version": { "type": "string", "minLength": 1 },
    "quality_suite_checksum": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
    "approved_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewer_role": { "enum": ["release_owner", "compliance_reviewer", "security_reviewer", "product_owner"] },
    "reviewer_permission": { "type": "string", "minLength": 1 },
    "reviewer_signature": { "type": "string", "pattern": "^hmac-sha256:[A-Za-z0-9_-]+$" },
    "reviewer_signature_algorithm": { "const": "HMAC-SHA256" },
    "rollback_generation_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
