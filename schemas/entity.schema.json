{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/entity.schema.json",
  "title": "OpenFin canonical entity",
  "type": "object",
  "required": ["id", "title", "type"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": { "enum": ["account-product", "application-channel", "bank-product", "benchmark-rate", "card-product", "category", "concept", "conflict-rule", "corporate-tax-support", "deduction", "deadline", "deposit-offer", "domain", "eligibility-rule", "filing", "financial-product", "financial-provider", "insurance-product", "life-event", "life-expense", "life-income", "offer-option", "required-document", "risk-signal", "saving-offer", "scenario", "source", "support-program", "tax", "tax-credit", "tax-reduction", "term"] },
    "parents": { "type": "array", "items": { "type": "string" } },
    "children": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string" } },
    "terms": { "type": "array", "items": { "type": "string" } },
    "deadlines": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string", "pattern": "^source\\." } },
    "requires": { "type": "array", "items": { "type": "string" } },
    "conflicts_with": { "type": "array", "items": { "type": "string" } },
    "available_in": { "type": "array", "items": { "type": "string" } },
    "provided_by": { "type": "array", "items": { "type": "string" } },
    "reference_items": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "array", "items": { "$ref": "provenance.schema.json" } },
    "field_assertions": { "type": "array", "items": { "$ref": "assertion.schema.json" } },
    "decision_critical": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "source" } } }, "then": { "$ref": "source.schema.json" } },
    { "if": { "properties": { "type": { "enum": ["category", "domain"] } } }, "then": { "required": ["canonical_folder", "population_status"] } },
    {
      "if": { "required": ["decision_critical"], "properties": { "decision_critical": { "const": true } } },
      "then": { "oneOf": [
        { "$ref": "types/deposit.schema.json" },
        { "$ref": "types/saving.schema.json" },
        { "$ref": "types/loan.schema.json" },
        { "$ref": "types/card.schema.json" },
        { "$ref": "types/insurance.schema.json" },
        { "$ref": "types/support-program.schema.json" }
      ] }
    },
    {
      "if": { "properties": { "type": { "const": "deposit-offer" } } },
      "then": { "$ref": "types/deposit-offer.schema.json" }
    },
    {
      "if": { "properties": { "type": { "const": "saving-offer" } } },
      "then": { "$ref": "types/saving-offer.schema.json" }
    },
    {
      "if": { "properties": { "type": { "const": "offer-option" } } },
      "then": { "$ref": "types/offer-option.schema.json" }
    }
  ],
  "additionalProperties": true
}
