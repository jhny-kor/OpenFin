{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/types/insurance-product.schema.json",
  "title": "OpenFin decision-critical insurance product",
  "type": "object",
  "required": ["id", "title", "type", "provider", "coverage_items", "coverage_amount_krw", "exclusions", "waiting_period_days", "reduced_benefit_period_days", "renewable", "premium_payment_term_months", "insurance_term_months", "surrender_value_condition", "field_assertions", "provenance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": { "const": "insurance-product" },
    "decision_critical": { "const": true },
    "provider": { "type": "string", "minLength": 1 },
    "coverage_items": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "coverage_amount_krw": { "type": "integer", "minimum": 0 },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "waiting_period_days": { "type": "integer", "minimum": 0 },
    "reduced_benefit_period_days": { "type": "integer", "minimum": 0 },
    "renewable": { "type": "boolean" },
    "premium_payment_term_months": { "type": "integer", "exclusiveMinimum": 0 },
    "insurance_term_months": { "type": "integer", "exclusiveMinimum": 0 },
    "surrender_value_condition": { "type": "string", "minLength": 1 },
    "field_assertions": { "type": "array", "minItems": 1, "items": { "$ref": "../assertion.schema.json" } },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "../provenance.schema.json" } }
  },
  "additionalProperties": false
}
