{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/types/insurance-product.schema.json",
  "title": "OpenFin decision-critical insurance product",
  "type": "object",
  "required": ["id", "title", "type", "provider", "field_assertions", "provenance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": { "const": "insurance-product" },
    "decision_critical": { "const": true },
    "provider": { "type": "string", "minLength": 1 },
    "field_assertions": { "type": "array", "minItems": 1, "items": { "$ref": "../assertion.schema.json" } },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "../provenance.schema.json" } }
  },
  "additionalProperties": false
}
