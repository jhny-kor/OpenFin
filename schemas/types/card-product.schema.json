{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/types/card-product.schema.json",
  "title": "OpenFin decision-critical card product",
  "type": "object",
  "required": ["id", "title", "type", "provider", "annual_fee_krw", "previous_month_spend_krw", "excluded_spend_conditions", "benefit_rate_percent", "monthly_benefit_limit_krw", "per_transaction_limit_krw", "benefit_overlap_policy", "field_assertions", "provenance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": { "const": "card-product" },
    "decision_critical": { "const": true },
    "provider": { "type": "string", "minLength": 1 },
    "annual_fee_krw": { "type": "integer", "minimum": 0 },
    "previous_month_spend_krw": { "type": "integer", "minimum": 0 },
    "excluded_spend_conditions": { "type": "array", "items": { "type": "string" } },
    "benefit_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "monthly_benefit_limit_krw": { "type": "integer", "minimum": 0 },
    "per_transaction_limit_krw": { "type": "integer", "minimum": 0 },
    "benefit_overlap_policy": { "enum": ["stackable", "non_stackable", "unknown"] },
    "field_assertions": { "type": "array", "minItems": 1, "items": { "$ref": "../assertion.schema.json" } },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "../provenance.schema.json" } }
  },
  "additionalProperties": false
}
