{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/types/offer-option.schema.json",
  "title": "OpenFin strict financial offer option",
  "type": "object",
  "required": ["option_id", "type", "term_months", "base_rate_percent", "maximum_rate_percent", "interest_method", "field_assertions"],
  "properties": {
    "option_id": { "type": "string", "minLength": 1 },
    "type": { "const": "offer-option" },
    "term_months": { "type": "integer", "exclusiveMinimum": 0 },
    "base_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "maximum_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "interest_method": { "type": "string", "minLength": 1 },
    "compounding_frequency": { "enum": ["annual", "monthly", "daily", "none"] },
    "interest_payment_frequency": { "enum": ["at_maturity", "annual", "monthly", "daily"] },
    "day_count_convention": { "enum": ["ACT/365", "ACT/366", "30/360"] },
    "accrual_days": { "type": "integer", "minimum": 1 },
    "accrual_basis": { "enum": ["simple", "compound", "daily_accrual"] },
    "rounding_policy": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["nearest", "floor", "ceil"] },
        "unit": { "const": "krw" }
      },
      "additionalProperties": false
    },
    "payment_timing": { "enum": ["month_start", "month_end"] },
    "payment_schedule_policy": {
      "type": "object",
      "properties": {
        "type": { "enum": ["fixed_monthly", "explicit_schedule"] },
        "allow_missed_installments": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "amount_limit": {
      "type": "object",
      "required": ["minimum_krw", "maximum_krw"],
      "properties": {
        "minimum_krw": { "type": ["integer", "null"], "minimum": 0 },
        "maximum_krw": { "type": ["integer", "null", "object"], "minimum": 0, "properties": { "status": { "const": "unlimited" } }, "required": ["status"], "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "monthly_payment_limit": {
      "type": "object",
      "required": ["minimum_krw", "maximum_krw"],
      "properties": {
        "minimum_krw": { "type": ["integer", "null"], "minimum": 0 },
        "maximum_krw": { "type": ["integer", "null", "object"], "minimum": 0, "properties": { "status": { "const": "unlimited" } }, "required": ["status"], "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "saving_method": { "type": "string", "minLength": 1 },
    "bonus_rate_rules": { "type": "array", "items": { "$ref": "bonus-rate-rule.schema.json" } },
    "unresolved_bonus_conditions": { "type": "array", "items": { "type": "string" } },
    "field_assertions": { "type": "array", "minItems": 1, "items": { "$ref": "../assertion.schema.json" } },
    "schema_validation_receipt": { "$ref": "../schema-validation-receipt.schema.json" },
    "promotion_receipt": { "$ref": "../candidate-promotion-receipt.schema.json" }
  },
  "additionalProperties": false
}
