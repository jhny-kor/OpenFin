{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/types/loan.schema.json",
  "title": "OpenFin decision-critical loan",
  "type": "object",
  "required": ["id", "title", "type", "provider", "product_kind", "base_rate_percent", "spread_rate_percent", "interest_rate_type", "credit_limit_krw", "repayment_method", "term_months", "early_repayment_fee_policy", "collateral_or_guarantee", "eligibility_conditions", "delinquency_rate_percent", "total_cost_basis", "field_assertions", "provenance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": { "const": "bank-product" },
    "decision_critical": { "const": true },
    "provider": { "type": "string", "minLength": 1 },
    "product_kind": { "const": "loan" },
    "repayment_method": { "type": "string", "minLength": 1 },
    "base_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "spread_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "interest_rate_type": { "enum": ["fixed", "variable", "mixed"] },
    "credit_limit_krw": { "type": "integer", "minimum": 0 },
    "term_months": { "type": "integer", "exclusiveMinimum": 0 },
    "early_repayment_fee_policy": { "type": "string", "minLength": 1 },
    "collateral_or_guarantee": { "type": "string", "minLength": 1 },
    "eligibility_conditions": { "type": "array", "items": { "type": "string" } },
    "delinquency_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "total_cost_basis": { "type": "string", "minLength": 1 },
    "field_assertions": { "type": "array", "minItems": 1, "items": { "$ref": "../assertion.schema.json" } },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "../provenance.schema.json" } }
  },
  "additionalProperties": false
}
