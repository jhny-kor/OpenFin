{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/types/bank-product.schema.json",
  "title": "OpenFin decision-critical bank product",
  "type": "object",
  "required": ["id", "title", "type", "provider", "product_kind", "term_months", "base_rate_percent", "maximum_rate_percent", "interest_method", "preferential_rate_conditions", "join_member", "join_channel", "sales_verification_status", "field_assertions", "provenance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "type": { "const": "bank-product" },
    "decision_critical": { "const": true },
    "provider": { "type": "string", "minLength": 1 },
    "product_kind": { "enum": ["deposit", "saving"] },
    "term_months": { "type": "integer", "exclusiveMinimum": 0 },
    "base_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "maximum_rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "interest_method": { "type": "string", "minLength": 1 },
    "preferential_rate_conditions": { "type": "array", "items": { "type": "string" } },
    "join_member": { "type": ["string", "array"], "items": { "type": "string" } },
    "join_channel": { "type": ["string", "array"], "items": { "type": "string" } },
    "minimum_deposit_krw": { "type": ["integer", "null"], "minimum": 0 },
    "maximum_deposit_krw": { "type": ["integer", "null"], "minimum": 0 },
    "monthly_payment_min_krw": { "type": ["integer", "null"], "minimum": 0 },
    "monthly_payment_max_krw": { "type": ["integer", "null"], "minimum": 0 },
    "saving_method": { "type": ["string", "null"] },
    "early_termination_condition": { "type": "string", "minLength": 1 },
    "deposit_protection_status": { "type": "string", "minLength": 1 },
    "sales_verification_status": { "const": "verified" },
    "field_assertions": { "type": "array", "minItems": 1, "items": { "$ref": "../assertion.schema.json" } },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "../provenance.schema.json" } }
  },
  "allOf": [
    { "if": { "properties": { "product_kind": { "const": "deposit" } } }, "then": { "required": ["minimum_deposit_krw", "maximum_deposit_krw", "early_termination_condition", "deposit_protection_status"] } },
    { "if": { "properties": { "product_kind": { "const": "saving" } } }, "then": { "required": ["monthly_payment_min_krw", "monthly_payment_max_krw", "saving_method", "early_termination_condition", "deposit_protection_status"] } }
  ],
  "additionalProperties": false
}
