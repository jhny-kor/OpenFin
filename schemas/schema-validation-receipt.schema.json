{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jhny-kor.github.io/OpenFin/schemas/schema-validation-receipt.schema.json",
  "title": "OpenFin AJV schema validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "validator", "validation_status", "validated_at", "content_checksum"],
  "properties": {
    "schema_id": { "type": "string", "minLength": 1 },
    "validator": { "const": "ajv" },
    "validation_status": { "enum": ["pending", "valid", "invalid"] },
    "validated_at": { "type": "string", "format": "date-time" },
    "content_checksum": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
