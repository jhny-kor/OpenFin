{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "openfin-recommendation-facts-v1",
  "facts": {
    "user.is_new_customer": { "type": "boolean", "source_classes": ["user_asserted", "system_inferred", "official_confirmed"], "request_paths": ["context.facts.is_new_customer"] },
    "user.can_transfer_salary": { "type": "boolean", "source_classes": ["user_asserted", "official_confirmed"], "request_paths": ["context.facts.can_transfer_salary"] },
    "user.can_set_auto_transfer": { "type": "boolean", "source_classes": ["user_asserted", "official_confirmed"], "request_paths": ["context.facts.can_set_auto_transfer"] },
    "user.can_use_card": { "type": "boolean", "source_classes": ["user_asserted", "official_confirmed"], "request_paths": ["context.facts.can_use_card"] },
    "user.age_years": { "type": "number", "source_classes": ["user_asserted", "official_confirmed"], "request_paths": ["context.facts.age_years"] },
    "user.residency_code": { "type": "string", "source_classes": ["user_asserted", "official_confirmed"], "request_paths": ["context.facts.residency_code"] },
    "user.customer_segment": { "type": "string", "source_classes": ["user_asserted", "system_inferred", "official_confirmed"], "request_paths": ["context.facts.customer_segment"] },
    "user.employment_type": { "type": "string", "source_classes": ["user_asserted", "official_confirmed"], "request_paths": ["context.facts.employment_type"] },
    "user.monthly_contribution_krw": { "type": "number", "source_classes": ["user_asserted"], "request_paths": ["context.facts.monthly_contribution_krw"] },
    "decision.as_of": { "type": "string", "source_classes": ["system_inferred"], "request_paths": ["context.as_of"] },
    "decision.term_months": { "type": "number", "source_classes": ["user_asserted", "system_inferred"], "request_paths": ["context.preferences.term_months", "context.hard_constraints.term_months"] },
    "decision.liquidity_horizon_months": { "type": "number", "source_classes": ["user_asserted", "system_inferred"], "request_paths": ["context.goal.liquidity_horizon_months"] },
    "withdrawal.before_maturity": { "type": "boolean", "source_classes": ["system_inferred"], "request_paths": [] }
  },
  "aliases": {
    "is_new_customer": "user.is_new_customer",
    "can_transfer_salary": "user.can_transfer_salary",
    "can_set_auto_transfer": "user.can_set_auto_transfer",
    "can_use_card": "user.can_use_card"
  },
  "unknown_policy": "unknown_is_not_matched"
}
